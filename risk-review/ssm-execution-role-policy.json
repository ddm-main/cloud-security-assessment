{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EC2DescribeInRegion",
      "Effect": "Allow",
      "Action": ["ec2:DescribeInstances", "ec2:DescribeInstanceStatus", "ec2:DescribeTags"],
      "Resource": "*",
      "Condition": { "StringEquals": { "aws:RequestedRegion": "eu-west-1" } }
    },
    {
      "Sid": "EC2PowerOnlyOnAutomationTargets",
      "Effect": "Allow",
      "Action": ["ec2:StartInstances", "ec2:RebootInstances"],
      "Resource": "arn:aws:ec2:eu-west-1:222222222222:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/AutomationAllowed": "true",
          "aws:ResourceTag/Application": "Automated-Deployment-Dev"
        }
      }
    },
    {
      "Sid": "SendOnlyTheApprovedDocument",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": "arn:aws:ssm:eu-west-1:222222222222:document/Automated-Deployment-Dev"
    },
    {
      "Sid": "SendOnlyToTaggedInstances",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": "arn:aws:ec2:eu-west-1:222222222222:instance/*",
      "Condition": {
        "StringEquals": {
          "ssm:resourceTag/AutomationAllowed": "true",
          "ssm:resourceTag/Application": "Automated-Deployment-Dev"
        }
      }
    },
    {
      "Sid": "WatchTheCommand",
      "Effect": "Allow",
      "Action": [
        "ssm:GetCommandInvocation", "ssm:ListCommandInvocations", "ssm:ListCommands",
        "ssm:DescribeInstanceInformation"
      ],
      "Resource": "*",
      "Condition": { "StringEquals": { "aws:RequestedRegion": "eu-west-1" } }
    },
    {
      "Sid": "LogsForDeploymentGroupsOnly",
      "Effect": "Allow",
      "Action": ["logs:CreateLogStream", "logs:PutLogEvents", "logs:DescribeLogStreams"],
      "Resource": "arn:aws:logs:eu-west-1:222222222222:log-group:/aws/ssm/deployment/*:*"
    },
    {
      "Sid": "DeployBucketObjectsOnly",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::automated-deployment-dev/deploy/*"
    },
    {
      "Sid": "DeployBucketLocation",
      "Effect": "Allow",
      "Action": "s3:GetBucketLocation",
      "Resource": "arn:aws:s3:::automated-deployment-dev"
    },
    {
      "Sid": "DenyTagGateTampering",
      "Effect": "Deny",
      "Action": ["ec2:CreateTags", "ec2:DeleteTags"],
      "Resource": "*",
      "Condition": { "ForAnyValue:StringEquals": { "aws:TagKeys": ["AutomationAllowed", "Application"] } }
    },
    {
      "Sid": "DenyInteractiveAndHighRiskSSM",
      "Effect": "Deny",
      "Action": [
        "ssm:StartSession", "ssm:ResumeSession", "ssm:CreateActivation", "ssm:CreateAssociation",
        "ssm:StartAssociationsOnce", "ssm:CreateDocument", "ssm:UpdateDocument*", "ssm:DeleteDocument",
        "ssm:ModifyDocumentPermission", "ssm:PutResourcePolicy", "ssm:GetParameter*", "ssm:PutParameter",
        "ssm:DeleteParameter*", "ssm:UpdateManagedInstanceRole", "ssm:DeregisterManagedInstance"
      ],
      "Resource": "*"
    }
  ]
}
